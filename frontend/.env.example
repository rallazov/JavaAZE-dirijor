#
# Dirijor frontend — local-dev environment template.
# Copy to `.env.local` and edit as needed (.env.local is gitignored by Next.js).
#
# Story 3.3 — Dirijor Core WebSocket base URL. The client appends
# `/{realmId}` to whatever you put here, so point at the realm *base*
# path (no trailing realm id, no trailing slash).
#
# --- Loopback (browser and supervisor on the same machine) ---
# In `.env.local`, use either this block OR the LAN block below — comment out the
# block you are not using so `NEXT_PUBLIC_*` keys are not duplicated.
NEXT_PUBLIC_DIRIJOR_WS_URL=ws://localhost:8000/ws/realm
NEXT_PUBLIC_DIRIJOR_API_URL=http://localhost:8000

# --- LAN / Next "Network" URL (browser reaches supervisor by host IP) ---
# If you open the canvas as http://192.168.1.5:3000 (or from another device),
# point BOTH vars at the host:port the *browser* can use to reach Core — NOT
# http://localhost:8000 (that is the *client* machine, so fetch surfaces network_error).
# WebSocket base is the ws/wss analogue of the HTTP API origin (path /ws/realm; client appends /{realmId}).
# NEXT_PUBLIC_DIRIJOR_API_URL=http://192.168.1.5:8000
# NEXT_PUBLIC_DIRIJOR_WS_URL=ws://192.168.1.5:8000/ws/realm
#
# CORS on Core: with default origins (no DIRIJOR_CORS_ORIGINS) and
# DIRIJOR_CORS_STRICT_LOCALHOST unset, Core may allow RFC1918 dev URLs via
# regex. Set DIRIJOR_CORS_ORIGINS=... for an explicit list, or
# DIRIJOR_CORS_STRICT_LOCALHOST=1 to disable the RFC1918 regex.
# See docs/guides/tutorials/01-first-realm.md and backend/dirijor-core/supervisor.py.

# When NEXT_PUBLIC_DIRIJOR_WS_URL is left unset or empty, the canvas stays in
# idle mode (no connection attempt); StatusBar will read
# "Idle (set NEXT_PUBLIC_DIRIJOR_WS_URL)".
