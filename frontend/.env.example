#
# Dirijor frontend — local-dev environment template.
# Copy to `.env.local` and edit as needed (.env.local is gitignored by Next.js).
#
# Story 3.3 — Dirijor Core WebSocket base URL. The client appends
# `/{realmId}` to whatever you put here, so point at the realm *base*
# path (no trailing realm id, no trailing slash).
#
# Local dev against `docker compose up`:
NEXT_PUBLIC_DIRIJOR_WS_URL=ws://localhost:8000/ws/realm

# When left unset or empty, the canvas keeps running in idle mode (no
# connection attempt); the transport label in StatusBar will read
# "Idle (set NEXT_PUBLIC_DIRIJOR_WS_URL)".

# Story 2.1 — Dirijor Core HTTP base URL. Defaults to http://localhost:8000
# when unset. The client appends paths like `/realms/spin` and
# `/realms/{job_id}` to whatever you put here.
#
# If you open the canvas from Next's "Network" URL (e.g. http://192.168.x.x:3001)
# on another device, set this to http://<that-host>:8000 so the browser does not
# call the wrong machine's localhost.
NEXT_PUBLIC_DIRIJOR_API_URL=http://localhost:8000
